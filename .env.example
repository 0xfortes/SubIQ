# Copy to .env and fill in. Validated at boot by src/lib/env.ts (that schema
# is the source of truth for what is required). Empty strings count as unset.

# --- Local development ---

# Postgres connection. Local dev can use a single direct connection.
DATABASE_URL="postgresql://user:password@localhost:5432/subiq"

# Direct (non-pooled) connection used ONLY by the Prisma CLI / migrations
# (read by prisma.config.ts, not the app runtime). Locally leave unset to
# reuse DATABASE_URL. See the production block below for why prod needs both.
# DIRECT_URL="postgresql://user:password@localhost:5432/subiq"

# Auth.js session/token signing secret. Required in production (min 32 chars).
# Generate: openssl rand -base64 33
AUTH_SECRET=""

# Bearer token for /api/cron/* . Required in production (min 16 chars); when
# unset in dev the cron routes are open on localhost.
# Generate: openssl rand -hex 24
CRON_SECRET=""

# Email egress (src/lib/email.ts). In dev, email logs to the server console —
# nothing is sent, so these are optional locally. Used for renewal reminder
# emails (auth is email+password, so these are NOT required to sign in).
# Reminders simply won't send until a verified sending domain is configured.
# RESEND_API_KEY=""
# EMAIL_FROM="SubIQ <login@yourdomain.com>"   # defaults to login@subiq.app

# Optional OAuth — set BOTH halves of a pair, or neither (enforced by env schema).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Sentry error monitoring (optional). Public DSN — safe to expose; it ships in
# the client bundle, so it uses the NEXT_PUBLIC_ prefix and is read directly in
# the instrumentation files, not via src/lib/env.ts. Unset = the SDK is a no-op.
# NEXT_PUBLIC_SENTRY_DSN=""


# --- Production: set these in the Vercel dashboard (Production scope), NOT here ---
# This file is a template; real prod values live only in Vercel's env settings.
#
#   DATABASE_URL    Supabase Transaction pooler, port :6543, append ?pgbouncer=true
#                   (serverless runtime; the pg driver adapter in src/lib/db.ts)
#   DIRECT_URL      Supabase Session pooler, port :5432
#                   (used by `prisma migrate deploy` during the Vercel build)
#   AUTH_SECRET     freshly generated per the command above — never reuse a shared value
#   CRON_SECRET     freshly generated per the command above
#   RESEND_API_KEY  from the Resend dashboard
#   EMAIL_FROM      an address on a domain VERIFIED in Resend
#   NEXT_PUBLIC_SENTRY_DSN  optional — project DSN from Sentry (errors-only)
#
# Do NOT set NODE_ENV (Vercel sets it to production). AUTH_URL is not needed —
# auth.ts uses trustHost:true.
