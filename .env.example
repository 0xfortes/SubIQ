# Copy to .env and fill in. Validated at boot by src/lib/env.ts.
DATABASE_URL="postgresql://user:password@localhost:5432/subiq"
# Auth.js secret (openssl rand -base64 33) — required in production
AUTH_SECRET=""
# Bearer token for /api/cron/* (openssl rand -hex 24) — required in
# production; unset in dev, cron routes are open on localhost.
CRON_SECRET=""
# Optional: real email sending in production
# RESEND_API_KEY=""
# EMAIL_FROM="SubIQ <login@yourdomain.com>"
# Optional OAuth (set both halves of a pair)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
